# Backend
SECRET_KEY='YOUR_Django_Secret_Key'
DEBUG=DEBUG(Boolean)
GEMINI_API_KEY='Your Gemini API Key From Google AI Studio'
ALLOWED_HOSTS=ALLOWED_HOSTS
CORS_ALLOWED_ORIGINS=CORS_ALLOWED_ORIGINS

# Email source: MOCK_MODE=True reads mock_emails.json (no credentials needed).
# Set MOCK_MODE=False to ingest real Gmail (requires OAuth setup below).
MOCK_MODE=True

# Gmail integration (only used when MOCK_MODE=False)
GMAIL_QUERY=is:unread
GMAIL_MAX_RESULTS=10

# Recommended: env-var credentials (no files needed, ideal for deployment).
# Copy client_id/secret from your Google Cloud OAuth client, then run
# `python manage.py gmail_auth` once to obtain GMAIL_REFRESH_TOKEN.
GMAIL_CLIENT_ID='Your OAuth Client ID'
GMAIL_CLIENT_SECRET='Your OAuth Client Secret'
GMAIL_REFRESH_TOKEN='Printed by gmail_auth after browser consent'

# Optional file-based fallback (paths relative to backend/ unless absolute).
# Only used if the env-var credentials above are not set.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=token.json

# Set PIPELINE_AUTOSTART=False to disable the background worker (e.g. during tests).
PIPELINE_AUTOSTART=True